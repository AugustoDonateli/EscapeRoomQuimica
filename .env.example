# Supabase — os valores estão no painel do projeto, em Settings > API.
#
# Nenhuma destas variáveis tem prefixo NEXT_PUBLIC_ de propósito: todo acesso
# ao banco acontece no servidor, e esse prefixo significa "pode ir para o
# pacote do navegador". Nenhuma delas vai.
#
# Os nomes com prefixo continuam aceitos e funcionam igual — a preferência
# aqui é de clareza.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave de serviço: ignora todas as políticas do banco. É a única daqui que
# realmente não pode vazar, e é usada só em src/lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site. É o que vai dentro dos QRs impressos das estações,
# então precisa ser o endereço final antes de imprimir cartaz.
SITE_URL=

# E-mail (etapa 7). Sem domínio verificado, o Resend só envia para o
# e-mail do dono da conta — ver docs/plano.md. Sem estas duas variáveis a
# plataforma simplesmente não promete e-mail: o lembrete fica sendo o convite
# de calendário, que funciona sem depender de nada.
RESEND_API_KEY=
EMAIL_REMETENTE=
