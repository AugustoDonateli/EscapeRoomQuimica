# Supabase — pegue estes valores no painel do projeto, em Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: usada SÓ no servidor (rotas de instrutor e admin).
# Nunca prefixe com NEXT_PUBLIC_ — isso vazaria a chave para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail (etapa 7). Sem domínio verificado, o Resend só envia para o
# e-mail do dono da conta — ver docs/plano.md.
RESEND_API_KEY=
